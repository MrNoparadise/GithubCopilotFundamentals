{
  // The demo repo's mcp.json plus the Figma remote MCP server.
  // The repo's own .vscode/mcp.json has angular-cli only.
  "servers": {
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli", "mcp"]
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    }
  }
}
